<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ ignora allowBackup para la transferencia entre dispositivos; estas reglas
     excluyen todos los datos de la app de la copia en la nube y de device-transfer.
     Motivo: el token de flutter_secure_storage depende de una clave del Keystore que no
     viaja con la copia, y la sesión no debe restaurarse en otro dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
