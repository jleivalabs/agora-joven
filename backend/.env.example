# Copia este archivo como .env en esta carpeta (backend/). .env no se versiona.
# No escribas aquí valores reales: este archivo de ejemplo sí se publica.

# Puerto del host donde Docker Compose publica la API.
API_PORT=8010

# Secreto para firmar los JWT (HS256). Obligatorio, mínimo 32 caracteres, sin valor por defecto.
# Genera uno en tu equipo y pégalo SOLO en .env, nunca en el chat ni en el repositorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Minutos de validez del token (opcional, por defecto 60).
JWT_EXPIRA_MINUTOS=60

# Ruta de la base SQLite fuera de Docker (opcional). En Docker la fija docker-compose.yml.
# DATABASE_URL=sqlite:///./data/agora.db
