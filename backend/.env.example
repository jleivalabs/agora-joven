# Copia este archivo como .env en esta carpeta (backend/). .env no se versiona.
# No escribas aquí valores reales: este archivo de ejemplo sí se publica.

# Puerto del host donde Docker Compose publica la API.
API_PORT=8010

# Secreto para firmar los JWT (HS256). Obligatorio, mínimo 32 caracteres, sin valor por defecto.
# Genera uno en tu equipo y pégalo SOLO en .env, nunca en el chat ni en el repositorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Minutos de validez del token (opcional, por defecto 60).
JWT_EXPIRA_MINUTOS=60

# Ruta de la base SQLite fuera de Docker (opcional). En Docker la fija docker-compose.yml.
# DATABASE_URL=sqlite:///./data/agora.db

# Asistente educativo (Gemini). Opcional: sin clave el backend arranca y el asistente responde 503.
# Crea la clave en Google AI Studio y pégala SOLO en backend/.env (nunca en el chat ni en Git).
GEMINI_API_KEY=
# Modelo estable usado por defecto (ver docs/ARQUITECTURA.md → Asistente).
GEMINI_MODEL=gemini-3.5-flash-lite
# Tiempo máximo de espera de la llamada a Gemini, en segundos (máximo 60).
GEMINI_TIMEOUT_SEGUNDOS=25

# Investigación asistida (Bloque 7C). Correo de contacto para el pool "polite" de Crossref; vacío,
# la búsqueda de referencias responde "no configurada". No se comparte con nadie más que Crossref.
CROSSREF_MAILTO=
# Redacción con Gemini sin búsqueda: desactivada hasta revisar el tratamiento de datos.
REDACCION_IA_ACTIVA=false
